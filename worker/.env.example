# Mesmas credenciais REST configuradas na Vercel (painel do Upstash -> REST API).
# O worker e a API da Vercel precisam apontar para a MESMA instância Redis —
# é assim que os dois lados enxergam a mesma fila e o mesmo hash de cada scan.
UPSTASH_REDIS_REST_URL="MY_UPSTASH_REDIS_REST_URL"
UPSTASH_REDIS_REST_TOKEN="MY_UPSTASH_REDIS_REST_TOKEN"

# Chave do Gemini para a Etapa 3 (triagem). Sem ela, o worker roda normalmente
# e mantém a classificação bruta do Nuclei/recon sem chamar IA nenhuma — não é
# um erro, é o estado de fallback (mesmo padrão do lado Node em server/aiTriage.ts).
GEMINI_API_KEY=""

# Opcional: caminho completo para o binário do nuclei, se ele não estiver no
# PATH do sistema (ex: "C:\ferramentas\nuclei.exe"). Deixe vazio para usar o
# nuclei do PATH.
NUCLEI_PATH=""

# Opcional: caminho completo para o binário do katana (crawler), mesma lógica
# do NUCLEI_PATH acima. Sem ele (nem no PATH), o Nuclei escaneia só a URL raiz
# do alvo em vez dos endpoints descobertos por crawl.
KATANA_PATH=""

# Opcional: um daemon do OWASP ZAP já rodando localmente (este worker não sobe
# nem gerencia o processo do ZAP, só se conecta como cliente). Sem um ZAP
# acessível nesta URL, a etapa de ZAP é pulada com um aviso, nunca falha o job.
ZAP_PROXY_URL="http://127.0.0.1:8080"
ZAP_API_KEY=""
