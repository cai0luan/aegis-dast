# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOW_DEMO_VERIFICATION: habilita o botão "Simular Sucesso (Modo Sandbox)" na tela
# de validação de domínio, que marca um alvo como verificado SEM nenhuma checagem
# criptográfica real (método gravado como SANDBOX_DEMO, nunca DNS_TXT/HTTP_FILE/HTML_META).
# Deixe "false" (ou remova) em qualquer ambiente que não seja demonstração local —
# é o único jeito de contornar a validação de posse de domínio (Anti-Abuse Core).
ALLOW_DEMO_VERIFICATION="false"

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN: credenciais REST do Redis do
# Upstash (painel do projeto -> REST API). Habilitam o modo assíncrono real:
# POST /api/scans enfileira o job (LPUSH aegis_jobs) em vez de rodar o pipeline na
# própria requisição, e o worker Python em worker/ (rodando fora da Vercel, ex: no
# seu notebook, onde Nuclei pode ser instalado de verdade) é quem processa a fila e
# grava o resultado de volta no hash scan:<id>. Ver server/queue.ts.
# Sem estas duas variáveis, o sistema continua funcionando normalmente com o
# pipeline síncrono em processo (recon real + amostra simulada de DAST) — rodar
# sem Redis é um estado suportado, não um erro.
UPSTASH_REDIS_REST_URL="MY_UPSTASH_REDIS_REST_URL"
UPSTASH_REDIS_REST_TOKEN="MY_UPSTASH_REDIS_REST_TOKEN"
